{
  "name": "moor",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm build:frontend",
    "build:frontend": "tsc -b && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "sidecar": "pnpm --filter moor-sidecar dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm sidecar\"",
    "lint": "vp lint src sidecar/src",
    "lint:fix": "vp lint src sidecar/src --fix",
    "format": "vp fmt \"src/**/*.{ts,tsx,css}\" \"sidecar/src/**/*.ts\"",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx,css}\" \"sidecar/src/**/*.ts\"",
    "version:sync": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs",
    "release:beta": "node scripts/pre-release.mjs beta",
    "release:rc": "node scripts/pre-release.mjs rc",
    "release:exit": "node scripts/pre-release-exit.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@moor/types": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@tanstack/react-query": "^5.100.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.469",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9",
    "tailwindcss": "^4",
    "typescript": "~5.7",
    "vite-plus": "catalog:"
  }
}
